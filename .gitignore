# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env

# Build folders
dist/
build/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prisma — keep schema + migrations, ignore the local SQLite DB
prisma/dev.db
prisma/*.db-journal
prisma/migrations/dev\Migration.lock

# Test DB (created by tests/integration/PrismaRepository.contract.test.js)
prisma/test.db
prisma/test.db-journal
prisma/test-*.db
prisma/test-*.db-journal

# user-uploaded images (shipped inside the offline package, never in git)
uploads/

# temp staging for ZIP backup imports
.import-staging/

# Student bundle temp build entry
src/frontend/.student-build-entry.js

# Offline install bundle — regenerate with: node scripts/generate-offline-bundle.mjs
vendor/offline/

# Local HTTPS certificates — generated per-machine by: node scripts/gen-https-certs.mjs
certs/

# mkcert binaries — only needed inside the distributed package (dist/)
vendor/mkcert/
