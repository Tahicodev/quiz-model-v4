# ── Deployment mode ───────────────────────────────────────────────────────────
# WHERE this installation runs. It is a topology, never a privilege: it selects
# the infrastructure that may be used and how the administration surface is
# labelled. It never grants or removes a capability.
#
#   offline → a school installation on its own machine / LAN. This server IS
#             the platform. No feature requires internet access.
#   saas    → a cloud deployment. This server is one node of a multi-tenant
#             product; platform administrators reach every organization.
#
# Resolution order: DEPLOYMENT_MODE → APP_MODE → DB_PROVIDER → default (saas).
# An unrecognised value stops the server at boot.
DEPLOYMENT_MODE=offline

# ── Database ──────────────────────────────────────────────────────────────────
# The provider is fixed by prisma/schema.prisma and the migration history:
# SQLite. DB_PROVIDER is informational (it labels the health panel).
# See docs/DATABASE.md for why PostgreSQL is not supported today.
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start with a shorter secret.
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Single active session: a login is rejected while the account holds a live
# session elsewhere unless the client sends force=true (take over). A refresh
# token counts as live while younger than this window (minutes).
SESSION_ACTIVE_WINDOW_MINUTES=30
# Grace window in which a rotated refresh token may be replayed by the same
# browser (two tabs of one browser rotating at the same moment).
REFRESH_ROTATION_GRACE_MS=30000
BCRYPT_ROUNDS=12

# The first administrator's password. Minimum 10 characters. When this is not
# set, `prisma db seed` GENERATES a random 20-character password and prints
# it once. There is no default password any more.
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# The allowed browser origin. Set it to the LAN address for a school install.
CORS_ORIGIN=http://localhost:3000
# `Secure` on the session cookie means "HTTPS only". Set it to true when the
# public URL is https:// (a TLS-terminating reverse proxy). LEAVE IT FALSE on
# a plain-HTTP LAN: a Secure cookie is dropped by the browser over HTTP and
# every session ends on the first reload.
COOKIE_SECURE=false
# Uploads (question images, generated documents) live here.
# UPLOADS_DIR=uploads

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Enable with TLS_ENABLED=1. Certificates come from the bundled mkcert:
#   node scripts/gen-https-certs.mjs
# TLS_ENABLED=1
# TLS_CERT_PATH=certs/server.crt
# TLS_KEY_PATH=certs/server.key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# "debug" in development, "info" in production, "warn" for quiet production

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Disabled in tests automatically. Set to true only for diagnostics.
# RATE_LIMIT_DISABLED=false

# ── Realtime ──────────────────────────────────────────────────────────────────
# Multi-instance Socket.IO adapter — SaaS only, leave blank for a LAN install.
# REDIS_URL=redis://localhost:6379

# ── AI question generation ────────────────────────────────────────────────────
# Server-side generation reads the model + key from Settings → AI Generation
# (stored encrypted), so no key needs to live in this file for that flow.
# The old env-based generator also exists: AI_PROVIDER / AI_API_KEY / AI_MODEL.
#
# Encryption key for stored provider keys. Falls back to JWT_SECRET. There is
# deliberately no literal default.
# AI_KEY_SECRET=
#
# AI image options (multiple-choice / multi / odd-one-out / draggable):
# auto-generate real option pictures when the selected provider is OpenAI,
# OpenRouter or a Google image model (Nano Banana, gemini-2.5-flash-image …).
# Selecting an image-only model auto-pairs it with a text sibling that writes
# the question text (same provider/key). Any other provider falls back to text
# options.
# AI_IMAGE_MODEL=gpt-image-1          # or openai/gpt-image-1 (OpenRouter)
# AI_IMAGE_QUESTION_MODEL=            # text model used when an image-only model is selected (default: gemini-2.5-flash / gpt-4o-mini)
# AI_IMAGE_SIZE=1024x1024             # 1024x1024 | 1536x1024 | 1024x1536
# AI_IMAGE_MAX_TOTAL=20               # cap images generated per request
# AI_IMAGE_CONCURRENCY=2              # parallel provider calls per question
# AI_IMAGE_FAKE=1                     # dev/test only: emit a 1x1 PNG, no API call

# ── Exam documents (PDF / Word generator) ─────────────────────────────────────
# Optional. The printable subject/answer-key PDF uses the built-in Helvetica and
# Times faces: full French accents are fine, other glyphs are transliterated and
# reported as warnings. Point this at any .ttf on the server to render non-Latin
# scripts (e.g. Arabic) in the PDF; Word files always keep the original text.
# EXAM_DOC_FONT_TTF=

# ── Tenant ────────────────────────────────────────────────────────────────────
# The organization a sign-in without an explicit tenant resolves to. On a LAN
# install this is the local school.
DEFAULT_SCHOOL_ID=local

# ── SaaS only ─────────────────────────────────────────────────────────────────
# SCHOOL_REGISTRATION_OPEN=false
# MAX_STUDENTS_PER_SCHOOL=500
