# ── Mode ──────────────────────────────────────────────────────────────────────
APP_MODE=local
# "local" → SQLite, single school, no internet required
# "saas"  → PostgreSQL, multi-tenant, cloud deployment

# ── Database ──────────────────────────────────────────────────────────────────
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# For SaaS:
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@localhost:5432/quizdb"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# "debug" in development, "info" in production, "warn" for quiet production

# ── Realtime ──────────────────────────────────────────────────────────────────
# For SaaS multi-instance only — leave blank for local mode
# REDIS_URL=redis://localhost:6379

# ── AI question generation ────────────────────────────────────────────────────
# Server-side generation reads the model + key from Settings → AI Generation
# (stored encrypted), so no key needs to live in this file for that flow.
# The old env-based generator also exists: AI_PROVIDER / AI_API_KEY / AI_MODEL.
#
# AI image options (multiple-choice / multi / odd-one-out / draggable):
# auto-generate real option pictures when the selected provider is OpenAI,
# OpenRouter or a Google image model (Nano Banana, gemini-2.5-flash-image …).
# Selecting an image-only model auto-pairs it with a text sibling that writes
# the question text (same provider/key). Any other provider falls back to text
# options.
# AI_IMAGE_MODEL=gpt-image-1          # or openai/gpt-image-1 (OpenRouter)
# AI_IMAGE_QUESTION_MODEL=            # text model used when an image-only model is selected (default: gemini-2.5-flash / gpt-4o-mini)
# AI_IMAGE_SIZE=1024x1024             # 1024x1024 | 1536x1024 | 1024x1536
# AI_IMAGE_MAX_TOTAL=20               # cap images generated per request
# AI_IMAGE_CONCURRENCY=2              # parallel provider calls per question
# AI_IMAGE_FAKE=1                     # dev/test only: emit a 1x1 PNG, no API call

# ── Tenant ────────────────────────────────────────────────────────────────────
# The single school id used in local mode (seeding + queries).
DEFAULT_SCHOOL_ID=local

# ── SaaS only ─────────────────────────────────────────────────────────────────
# SCHOOL_REGISTRATION_OPEN=false
# MAX_STUDENTS_PER_SCHOOL=500
