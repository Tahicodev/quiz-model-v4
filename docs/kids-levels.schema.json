            {
              "type": "null"
            }
          ]
        },
        "options": {
          "minItems": 2,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "image": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "emoji": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "value"
            ]
          }
        },
        "correctId": {
          "type": "string"
        }
      },
      "required": [
        "instruction",
        "question",
        "options",
        "correctId"
      ]
    },
    "word_order": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "value"
            ]
          }
        }
      },
      "required": [
        "instruction",
        "answer",
        "items"
      ]
    },
    "drag_drop": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "blanks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "position",
              "answer"
            ]
          }
        },
        "choices": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "value"
            ]
          }
        }
      },
      "required": [
        "instruction",
        "template",
        "blanks",
        "choices"
      ]
    },
    "matching": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
