      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "minItems": 2,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
