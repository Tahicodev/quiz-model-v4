        },
        "categories": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "anyOf": [
