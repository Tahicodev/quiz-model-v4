      ]
    },
    "memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "minItems": 4,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "matchId": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "image": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "emoji": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "default": "text",
                "type": "string",
                "enum": [
                  "text",
                  "image",
                  "emoji"
                ]
              }
            },
            "required": [
              "id",
              "matchId",
              "value"
            ]
          }
