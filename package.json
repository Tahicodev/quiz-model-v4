{
	"name": "quiz-model-v4-server",
	"version": "4.0.0",
	"type": "module",
	"description": "Quiz App server (Express + Socket.IO + Prisma) — SaaS deployment",
	"main": "src/backend/server.js",
	"scripts": {
		"start": "node src/backend/server.js",
		"dev": "node --watch src/backend/server.js",
		"build": "npm run build:admin && npm run build:student",
		"build:admin": "esbuild src/frontend/admin-main.js --bundle --outfile=public/admin-bundle.js --format=iife --global-name=QuizAdmin",
		"build:student": "node scripts/build-student.js",
		"postinstall": "npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0",
		"@socket.io/redis-adapter": "^8.3.0",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^4.22.2",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"jsdom": "^24.1.3",
		"jsonwebtoken": "^9.0.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"redis": "^6.1.0",
		"socket.io": "^4.7.2",
		"socket.io-client": "^4.8.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"esbuild": "^0.28.1",
		"prisma": "^5.22.0",
		"supertest": "^7.2.2",
		"vitest": "^4.1.9"
	},
	"prisma": {
		"seed": "node prisma/seed.js"
	}
}
